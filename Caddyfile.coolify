# Coolify in-stack Caddy. Coolify's proxy terminates TLS and routes the
# public hostname to this container on :8080.
# `web` shares the `server` network namespace, so UI traffic goes to
# server:3001 (same as the repo Caddyfile).

:8080 {
	# Streamable HTTP must not be gzip-buffered. flush_interval -1
	# writes each chunk to the client immediately.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy server:3000 {
			flush_interval -1
		}
	}

	@compressible not path /mcp /mcp/*
	encode @compressible gzip zstd

	@api path /api/* /rpc/*
	handle @api {
		reverse_proxy server:3000
	}

	handle {
		reverse_proxy server:3001
	}
}
