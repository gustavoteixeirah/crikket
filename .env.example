# Copy this file to .env and edit values for your environment.
# Docker Compose automatically reads .env from the project root.

# Published ports on host
WEB_PORT=3001
SERVER_PORT=3000
POSTGRES_PORT=5432

# Self-host database mode
CRIKKET_DATABASE_MODE=bundled

# Optional built-in Caddy reverse proxy
CRIKKET_PROXY_MODE=
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_ACME_EMAIL=
CADDY_PUBLIC_HOST=

# Optional: bundled postgres service settings only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crikket
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# Optional Google OAuth (server). Empty = disabled. Set both to enable.
# Coolify: add these names on the compose stack; never commit values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Resend email (server). Empty = disabled. Set both to enable.
# Invites still work without these via copyable /invite/{id} links.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional leftover web build arg. The live Google button is gated by
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET (server /api/public-config).
# Leave empty/false. Do not set true unless you also set the server creds.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
