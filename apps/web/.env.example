NEXT_PUBLIC_SITE_URL=https://crikket.io
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Unused at runtime for the Google button. Google is enabled when the server
# has both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. Keep false/empty.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Posthog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Crikket Capture (optional)
NEXT_PUBLIC_CRIKKET_KEY=
