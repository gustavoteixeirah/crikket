# Build-time origins the extension uses to reach the web app and API.
# Kode GT production uses https://crikket.kodegt.com for both.
# Example for another host:
#   VITE_APP_URL=https://your-host.example VITE_SERVER_URL=https://your-host.example bun run build --filter=extension
VITE_APP_URL=http://localhost:3001
VITE_SERVER_URL=http://localhost:3000
