<CORSConfiguration>
  <CORSRule>
    <AllowedOrigin>https://crikket.kodegt.com</AllowedOrigin>
    <AllowedOrigin>chrome-extension://PASTE_CHROME_EXTENSION_ID</AllowedOrigin>
    <AllowedMethod>GET</AllowedMethod>
